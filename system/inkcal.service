[Unit]
Description=E-ink calendar
Wants=NetworkManager.service
After=NetworkManager.service inkcal-firstboot.service

[Service]
Type=simple
User=inkcal
Group=inkcal
SupplementaryGroups=spi gpio netdev
WorkingDirectory=/opt/inkcal
Environment=INKCAL_DATA=/var/lib/inkcal
Environment=INKCAL_ETC=/etc/inkcal
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m inkcal run
# Port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=no
Restart=always
RestartSec=5
# The Pi Zero 2 has 512 MB; keep us honest
MemoryMax=200M

[Install]
WantedBy=multi-user.target
